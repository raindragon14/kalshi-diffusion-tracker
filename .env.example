# Kalshi Diffusion Tracker Configuration
# Copy to .env and fill in your values

# ============================================
# KALSHI SETTINGS
# ============================================
# Market ticker to track (e.g., FEDFUNDS, ECB, CPI, etc.)
# Find tickers at https://api.elections.kalshi.com/trade-api/v2/markets
KALSHI_MARKET_TICKER=FEDFUNDS

# Polling interval for price data (seconds)
KALSHI_POLL_INTERVAL=300

# ============================================
# FIRECRAWL SETTINGS
# ============================================
# Get API key from https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Search queries for news (comma-separated)
# Example: "federal reserve interest rate decision,fed funds rate,monetary policy"
FIRECRAWL_SEARCH_QUERIES=federal reserve interest rate decision,fed funds rate,monetary policy,FOMC

# How often to search for new articles (seconds)
FIRECRAWL_POLL_INTERVAL=1800

# Max articles to fetch per search
FIRECRAWL_MAX_ARTICLES=10

# ============================================
# JEV / OPENROUTER SETTINGS
# ============================================
# Get API key from https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Jev model on OpenRouter
JEV_MODEL=typesafe/jev-1.13

# Failover: Vercel AI Gateway endpoint (optional)
# Format: https://gateway.vercel.ai/v1/chat/completions
VERCEL_AI_GATEWAY_URL=

# Vercel AI Gateway auth token (optional)
VERCEL_AI_GATEWAY_TOKEN=

# Request timeout (seconds)
JEV_REQUEST_TIMEOUT=30

# Max retries for Jev API
JEV_MAX_RETRIES=3

# ============================================
# DATABASE SETTINGS
# ============================================
DATABASE_PATH=data/kalshi_diffusion.db

# ============================================
# DIFFUSION MODEL SETTINGS
# ============================================
# Time window after news to analyze (seconds)
DIFFUSION_WINDOW=3600

# Minimum price change to consider (absolute)
MIN_PRICE_CHANGE=0.01

# ============================================
# DASHBOARD SETTINGS
# ============================================
DASHBOARD_OUTPUT_DIR=dashboard
DASHBOARD_TITLE=Kalshi Information Diffusion Tracker